<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Workbench.Desktop"
        x:Class="Workbench.Desktop.ConnectionsWindow"
        Title="{x:Static local:ProductIdentity.WindowTitle}" Width="980" Height="790" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" CanResize="True">
  <Window.Styles>
    <Style Selector="TabControl.settings-navigation > TabItem">
      <Setter Property="Width" Value="182" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TabControl.settings-navigation > TabItem:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.skill-list ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.skill-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#303238" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.settings-hint">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="182,*" Margin="0,0,0,18">
      <TextBlock Text="{local:Loc SettingsTitle}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{local:Loc SettingsDescription}" Classes="settings-hint" VerticalAlignment="Center" Margin="24,0,0,0" />
    </Grid>
    <TabControl x:Name="SettingsNavigation" Classes="settings-navigation" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="SettingsNavigationChanged">
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc General}" /></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="24,12,4,12">
            <TextBlock Text="{local:Loc General}" Classes="section-title" />
            <TextBlock Text="{local:Loc Language}" FontWeight="SemiBold" />
            <ComboBox x:Name="LanguagePicker" HorizontalAlignment="Stretch" SelectionChanged="LanguageSelectionChanged">
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate><TextBlock Text="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" /></DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBoxItem Content="{local:Loc SystemLanguage}" />
              <ComboBoxItem Content="简体中文" />
              <ComboBoxItem Content="English" />
            </ComboBox>
            <TextBlock Text="{local:Loc LanguageHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
            <TextBlock Text="{local:Loc Appearance}" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="{local:Loc AppearanceHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            <CheckBox x:Name="ReducedMotionToggle" Content="{local:Loc ReducedMotion}" IsCheckedChanged="ReducedMotionChanged" Margin="0,8,0,0" />
            <TextBlock Text="{local:Loc ReducedMotionHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc ModelsAndAccounts}" /></TabItem.Header>
        <Grid RowDefinitions="Auto,Auto,*" Margin="24,12,4,0">
          <TextBlock Text="{local:Loc ModelsAndAccounts}" Classes="section-title" />
          <StackPanel Grid.Row="1" Spacing="8" Margin="0,4,0,14">
      <TextBlock Text="{local:Loc ConnectionChoice}" FontWeight="SemiBold" />
      <ComboBox x:Name="BackendChoice" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc ChooseConnection}" SelectionChanged="BackendSelectionChanged">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate><TextBlock Text="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" /></DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
        <ComboBoxItem Tag="chatgpt" Content="{local:Loc ContinueWithChatGpt}" />
        <ComboBoxItem Tag="api" Content="{local:Loc UseApiKey}" />
      </ComboBox>
          </StackPanel>
          <TabControl x:Name="SettingsTabs" Grid.Row="2">
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc ChatGptAccount}" /></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16" Margin="0,18,0,12">
            <Border CornerRadius="10" Background="#1D2530" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{local:Loc OfficialAuth}" Foreground="#8EDBCD" FontWeight="SemiBold" />
                <TextBlock Text="{local:Loc OfficialAuthDescription}" Foreground="#A7B3C6" TextWrapping="Wrap" LineHeight="21" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="AccountStatus" Text="{local:Loc AccountLoading}" TextWrapping="Wrap" Foreground="#B8C4D6" />
            <ComboBox x:Name="AccountPicker" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc SavedAccounts}" SelectionChanged="AccountSelectionChanged" />
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="LoginButton" Classes="primary" Content="{local:Loc ContinueWithChatGpt}" Click="LoginClick" Margin="0,0,9,8" />
              <Button x:Name="AddAccountButton" Classes="quiet" Content="{local:Loc AddAccount}" Click="AddAccountClick" Margin="0,0,9,8" />
              <Button x:Name="RefreshAccountButton" Classes="quiet" Content="{local:Loc RefreshAccount}" Click="RefreshClick" Margin="0,0,9,8" />
              <Button x:Name="LogoutButton" Classes="quiet" Content="{local:Loc Logout}" Click="LogoutClick" Margin="0,0,0,8" />
            </WrapPanel>
            <Button x:Name="ManageUsageButton" Classes="quiet" Content="{local:Loc ManageChatGptUsage}" Click="ManageUsageClick" HorizontalAlignment="Left" />
            <Border x:Name="LoginPanel" IsVisible="False" Background="#242033" CornerRadius="8" Padding="12">
              <StackPanel Spacing="8">
                <TextBlock x:Name="LoginHint" Text="{local:Loc LoginRefreshHint}" Foreground="#B7A9E8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{local:Loc ContinueLogin}" Classes="quiet" Click="OpenLoginClick" />
                  <Button x:Name="CancelLoginButton" Content="{local:Loc CancelLogin}" Classes="quiet" Click="CancelLoginClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{local:Loc Model}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="CodexModels" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc ModelsPlaceholder}" SelectionChanged="ModelSelectionChanged">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="CodexModelBox" PlaceholderText="{local:Loc DefaultModelPlaceholder}" />
            <TextBlock Text="{local:Loc TokenPrivacy}" Foreground="#77859D" FontSize="11" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc ApiBackend}" /></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,18,0,12">
            <TextBlock Text="{local:Loc ProviderPreset}" FontWeight="SemiBold" />
            <ComboBox x:Name="ApiPresetPicker" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc ProviderPresetPlaceholder}" SelectionChanged="ApiPresetChanged">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
              <TextBlock Text="{local:Loc Provider}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{local:Loc ProviderDefaults}" Classes="quiet" Click="ProviderDefaultsClick" Padding="8,4" />
            </Grid>
            <ComboBox x:Name="ProviderPicker" HorizontalAlignment="Stretch" SelectionChanged="ProviderSelectionChanged">
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate><TextBlock Text="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" /></DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBoxItem Tag="Auto" Content="{local:Loc ProviderAuto}" />
              <ComboBoxItem Tag="DeepSeek" Content="DeepSeek" />
              <ComboBoxItem Tag="Anthropic" Content="Anthropic / Claude" />
              <ComboBoxItem Tag="OpenAiCompatible" Content="{local:Loc ProviderCompatible}" />
              <ComboBoxItem Tag="OpenAiResponses" Content="OpenAI Responses API" />
            </ComboBox>
            <TextBlock Text="{local:Loc Endpoint}" FontWeight="SemiBold" />
            <TextBox x:Name="EndpointBox" PlaceholderText="https://api.example.com/v1" TextChanged="EndpointChanged" />
            <TextBlock x:Name="ProviderDetectionLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{local:Loc ProviderEndpointHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{local:Loc ModelId}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="ApiModelBox" PlaceholderText="{local:Loc ApiModelPlaceholder}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <ComboBox x:Name="ApiModelsPicker" HorizontalAlignment="Stretch" PlaceholderText="{local:Loc ApiModelCatalogPlaceholder}" SelectionChanged="ApiModelChanged">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="FetchApiModelsButton" Grid.Column="1" Classes="quiet" Content="{local:Loc FetchApiModels}" Click="FetchApiModelsClick" />
            </Grid>
            <TextBlock Text="{local:Loc ApiModelCatalogHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{local:Loc ApiKeyLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="ApiKeyBox" PasswordChar="●" PlaceholderText="{local:Loc ApiKeyPlaceholder}" />
            <WrapPanel>
              <Button x:Name="SaveApiKeyButton" Content="{local:Loc SaveApiKey}" Classes="quiet" Click="SaveApiKeyClick" Margin="0,0,8,0" />
              <Button x:Name="RemoveApiKeyButton" Content="{local:Loc RemoveApiKey}" Classes="quiet" Click="RemoveApiKeyClick" />
            </WrapPanel>
            <TextBlock Text="{local:Loc ApiKeyStoreHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{local:Loc KeyVariable}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="KeyVariableBox" PlaceholderText="DEEPSEEK_API_KEY" TextChanged="KeyVariableChanged" />
            <TextBlock x:Name="KeyStatus" Foreground="#8EDBCD" FontSize="11" TextWrapping="Wrap" />
            <Border CornerRadius="9" Background="#1B2330" Padding="13" Margin="0,7,0,0">
              <TextBlock Text="{local:Loc KeyPrivacy}" Foreground="#99A8C0" TextWrapping="Wrap" LineHeight="20" FontSize="12" />
            </Border>
            <TextBlock Text="{local:Loc MaxOutputTokens}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <NumericUpDown x:Name="MaxTokensBox" Minimum="1" Maximum="1000000" Increment="256" Value="4096" FormatString="0" />
            <StackPanel x:Name="ProviderOptionsPanel" Spacing="10" Margin="0,14,0,0">
              <TextBlock Text="{local:Loc ReasoningEffort}" FontWeight="SemiBold" />
              <ComboBox x:Name="ReasoningPicker" HorizontalAlignment="Stretch">
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate><TextBlock Text="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" /></DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
              </ComboBox>
              <TextBlock x:Name="ReasoningHint" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" />
              <StackPanel x:Name="LegacyThinkingPanel" Spacing="8" IsVisible="False">
                <CheckBox x:Name="LegacyThinkingToggle" Content="{local:Loc LegacyThinking}" IsCheckedChanged="LegacyThinkingChanged" />
                <StackPanel x:Name="LegacyBudgetPanel" Spacing="6" IsVisible="False">
                  <NumericUpDown x:Name="ThinkingBudgetBox" Minimum="1024" Maximum="999999" Increment="1024" Value="2048" FormatString="0" />
                  <TextBlock Text="{local:Loc LegacyThinkingHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="ImageCapabilityPanel" Spacing="5" IsVisible="False">
                <CheckBox x:Name="ImageCapabilityToggle" Content="{local:Loc ModelSupportsImages}" />
                <TextBlock Text="{local:Loc ModelImagesHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="18" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem x:Name="SkillsCategory">
        <TabItem.Header><TextBlock Text="{local:Loc Skills}" /></TabItem.Header>
        <ScrollViewer x:Name="SkillsScrollViewer" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="24,12,4,12">
            <TextBlock Text="{local:Loc Skills}" Classes="section-title" />
            <TextBlock Text="{local:Loc SkillsDescription}" Classes="settings-hint" />
            <TextBlock x:Name="SkillsWorkspaceLabel" Classes="settings-hint" />
            <TextBlock x:Name="SkillsProjectRequiredLabel" Text="{local:Loc SkillsProjectRequired}" Classes="settings-hint" />
            <StackPanel x:Name="SkillsProjectPanel" Spacing="12">
              <TextBlock Text="{local:Loc SkillsInstalled}" FontWeight="SemiBold" Margin="0,12,0,0" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock x:Name="SkillsInstalledSummary" Classes="settings-hint" VerticalAlignment="Center" />
                <Button x:Name="RefreshSkillsButton" Grid.Column="1" Classes="quiet" Content="{local:Loc Refresh}" Click="RefreshSkillsClick" />
              </Grid>
              <ListBox x:Name="InstalledSkillsList" Classes="skill-list" IsVisible="False" MinHeight="60" MaxHeight="190" AutomationProperties.Name="{local:Loc SkillsInstalled}">
                <ListBox.ItemTemplate><DataTemplate>
                  <StackPanel Spacing="4" Margin="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="settings-hint" />
                    <TextBlock Text="{Binding RelativePath}" Classes="settings-hint" FontSize="11" />
                  </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="{local:Loc SkillsImport}" FontWeight="SemiBold" Margin="0,16,0,0" />
              <TextBlock x:Name="SkillImportHintLabel" Text="{local:Loc SkillsImportHint}" Classes="settings-hint" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SkillImportPathBox" PlaceholderText="{local:Loc SkillFolderPath}" AutomationProperties.Name="{local:Loc SkillFolderPath}" />
                <Button x:Name="BrowseSkillFolderButton" Grid.Column="1" Classes="quiet" Content="{local:Loc BrowseSkillFolder}" Click="BrowseSkillFolderClick" />
              </Grid>
              <Button x:Name="ImportSkillButton" Classes="quiet" Content="{local:Loc ImportSkill}" Click="ImportSkillClick" HorizontalAlignment="Left" />
              <TextBlock Text="{local:Loc SkillsCatalog}" FontWeight="SemiBold" Margin="0,16,0,0" />
              <TextBlock Text="{local:Loc SkillsCatalogHint}" Classes="settings-hint" />
              <TextBlock x:Name="SkillCatalogWarningLabel" Classes="settings-hint" FontSize="11" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="SkillSearchBox" PlaceholderText="{local:Loc SearchSkillsPlaceholder}" AutomationProperties.Name="{local:Loc SearchSkills}" />
                <Button x:Name="SearchSkillsButton" Grid.Column="1" Classes="quiet" Content="{local:Loc SearchSkills}" Click="SearchSkillsClick" />
              </Grid>
              <ListBox x:Name="SkillCatalogList" Classes="skill-list" IsVisible="False" MinHeight="70" MaxHeight="220" SelectionChanged="SkillCatalogSelectionChanged" AutomationProperties.Name="{local:Loc SkillsCatalog}">
                <ListBox.ItemTemplate><DataTemplate>
                  <StackPanel Spacing="4" Margin="4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Classes="settings-hint" />
                    <TextBlock Text="{Binding SourceLabel}" Classes="settings-hint" FontSize="11" />
                  </StackPanel>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="InstallSkillButton" Classes="primary" Content="{local:Loc InstallSelectedSkill}" Click="InstallSkillClick" IsEnabled="False" HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock x:Name="SkillsNoticeLabel" TextWrapping="Wrap" Foreground="#E6B798" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc SettingsConnections}" /></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="24,12,4,12">
            <TextBlock Text="{local:Loc SettingsConnections}" Classes="section-title" />
            <TextBlock Text="{local:Loc SettingsConnectionsHint}" Classes="settings-hint" />
            <TextBlock x:Name="SettingsHostLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Button x:Name="OpenHostConnectionsButton" Classes="quiet" Content="{local:Loc RemoteConnectionsTitle}" Click="OpenHostConnectionsClick" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header><TextBlock Text="{local:Loc Advanced}" /></TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" Margin="24,12,4,12">
            <TextBlock Text="{local:Loc Advanced}" Classes="section-title" />
            <TextBlock Text="{local:Loc RunBudgetTitle}" FontWeight="SemiBold" Margin="0,10,0,0" />
            <TextBlock Text="{local:Loc SettingsRunBudgetHint}" Classes="settings-hint" />
            <Button x:Name="OpenRunBudgetButton" Classes="quiet" Content="{local:Loc RunBudgetTitle}" Click="OpenRunBudgetClick" HorizontalAlignment="Left" />
            <TextBlock Text="{local:Loc ResearchFeatures}" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="{local:Loc ResearchFeaturesHint}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" />
            <CheckBox x:Name="CompressionGuidanceToggle" Content="{local:Loc CompressionGuidanceFeature}" IsCheckedChanged="ResearchChanged" />
            <CheckBox x:Name="RepositoryMemoryToggle" Content="{local:Loc RepositoryMemoryFeature}" IsCheckedChanged="ResearchChanged" />
            <CheckBox x:Name="ReadOnlyPrefetchToggle" Content="{local:Loc ReadOnlyPrefetchFeature}" IsCheckedChanged="ResearchChanged" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Spacing="12" Margin="206,18,0,0">
      <TextBlock x:Name="NoticeLabel" TextWrapping="Wrap" Foreground="#E6B798" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
        <Button Content="{local:Loc Cancel}" Classes="quiet" Click="CancelClick" />
        <Button x:Name="SaveButton" Content="{local:Loc SaveSettings}" Classes="primary" Click="SaveClick" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
